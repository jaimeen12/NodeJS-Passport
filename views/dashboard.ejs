<h1 class="mt-4">Dashboard</h1>
<p class="lead mb-3">Welcome <%= name %></p>

<%- include('./partials/messages.ejs') %>

<h1 class="mt-4">Notes</h1>

<div class="d-grid gap-2">
    <a href="/createNoteForm" class="btn btn-lg btn-primary">Create a Note</a>
  </div>

  <br>

  <table class="table table-hover">
    <thead>
      <tr class="table-dark">
        <th scope="col">ID</th>
        <th scope="col">Title</th>
        <th scope="col">Status</th>
        <th scope="col">Update/Delete</th>
      </tr>
    </thead>
    <tbody>
    <% notes.forEach(note => { %>
      <tr class="table-light">
        <td><%= note.id %></td>
        <td><%= note.title %></td>
        <td><%= note.status %></td>

        <td><a class="btn btn-raised btn-danger" href="/updateNoteForm/<%= note.id %>">Update</a>  <a class="btn btn-raised btn-danger" href="/deleteNote/<%= note.id %>">Delete</a></td>
        
        
      </tr>          
      <% }); %>
    </tbody>
  </table>

  <h1 class="mt-4">Files</h1>

  <div class="d-grid gap-2">
    <a href="/upload" class="btn btn-lg btn-info">Upload a File</a>
  </div>

  <br>

  <table class="table table-hover">
    <thead>
      <tr class="table-dark">
        <th scope="col">Files</th>
      </tr>
    </thead>
    <tbody>
    <% fileList.forEach(file => { %>
      <tr class="table-light">
        <td><a href="/downloadfile/<%= file %>"><%= file %></a></td>

        
        
      </tr>          
      <% }); %>
    </tbody>
  </table>

  <a href="/user/logout" class="btn btn-secondary">Logout</a>